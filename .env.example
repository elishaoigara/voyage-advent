# Public Supabase settings: use a dedicated Voyage Advent project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase secret key (or legacy service_role key).
# NEVER prefix with NEXT_PUBLIC_. Never commit .env.local.
SUPABASE_SECRET_KEY=
# Set after connecting your Vercel/custom domain, including https://
NEXT_PUBLIC_SITE_URL=

# Reserved for the later Daraja integration. These alone do NOT enable payments.
# No live STK request/callback routes are enabled in this release.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
